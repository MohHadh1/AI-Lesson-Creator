# AI Lesson Creator — environment variable template.
# Copy this file to .env and fill in your API key.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# .gitignore excludes .env so your real key is never committed.

# Gemini API key — required for lesson generation and both QC reviews.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model ID.
# Leave blank to use the default (gemini-3.5-flash).
# GEMINI_MODEL=
